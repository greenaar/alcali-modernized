FROM python:3.12-slim-bookworm

ARG USER_ID=1000
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/alcali/.local/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates default-libmysqlclient-dev build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid "${USER_ID}" --create-home --home-dir /opt/alcali --shell /bin/bash alcali

WORKDIR /opt/alcali/code
COPY --chown=alcali:alcali . .
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements/prod.txt -r requirements/test.txt -r requirements/dev.txt "mysqlclient>=2.2,<3"

USER alcali
ENTRYPOINT ["/opt/alcali/code/docker/utils/entrypoint-dev.sh"]
