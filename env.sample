MASTER_MINION_ID=master

# DB
DB_BACKEND=mysql
DB_NAME=salt
DB_USER=alcali
DB_PASS=alcali
DB_HOST=db
DB_PORT=3306

# django
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=*

# salt-api
SALT_URL=https://master:8080
SALT_AUTH=rest
SALT_VERIFY_TLS=true
# SALT_CA_BUNDLE=/run/secrets/salt-ca.pem
SALT_TIMEOUT=30
# With SALT_VERIFY_TLS=false, silence urllib3's per-request warning.
# SALT_SUPPRESS_TLS_WARNING=true

# Logging: stderr always, plus a file when LOG_FILE is set.
# LOG_FILE=/var/log/alcali/alcali.log
# LOG_LEVEL=INFO
# LOG_CONSOLE=true

# Set these when served behind an HTTPS reverse proxy.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
