# Production environment for docker-compose.prod.yml.
#
#   cp env.prod.sample .env
#
# Compose reads this file twice: once for ${...} substitution inside
# docker-compose.prod.yml, and once as the containers' env_file. Every value
# below is therefore visible to the application container.
#
# Replace every credential. Nothing here is a usable default.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# The released image from the Forgejo container registry. Pin a version;
# `latest` makes it impossible to tell what is deployed.
#
# The tag must be a release built from a revision that carries this compose
# file's helper scripts (docker/utils/migrate.sh and healthcheck.py). If you
# are pinning an older release, build from this checkout instead:
#   docker compose -f docker-compose.prod.yml up -d --build
ALCALI_IMAGE=forge.thatserver.ca/salt/alcali:3008.2.0

# ---------------------------------------------------------------------------
# Where the stack listens
# ---------------------------------------------------------------------------
# gunicorn is not a TLS terminator and does not rate-limit. Keep it on
# loopback and put nginx or Caddy in front. Widen this only if something else
# already terminates TLS in front of the host.
ALCALI_PUBLISH_ADDRESS=127.0.0.1
ALCALI_PUBLISH_PORT=8000

# ---------------------------------------------------------------------------
# Database - the Salt master's returner database
# ---------------------------------------------------------------------------
# Alcali does not have a database of its own. It reads the job cache and event
# tables the master writes through master_job_cache/event_return, and adds its
# own tables to the same schema. Point DB_HOST at whatever the master is
# already returning to.
#
# Set DB_HOST=db only when running with `--profile bundled-db`, in which case
# this stack owns the database and the master must be reconfigured to return
# to it. See docs/docs/docker.md.
DB_BACKEND=mysql
DB_NAME=salt
DB_USER=alcali
DB_PASS=
DB_HOST=
DB_PORT=3306

# Used by the bundled-db profile only.
MARIADB_ROOT_PASSWORD=
# The master reaches the bundled database through this published port. Leave
# it on loopback when the master runs on this same host.
DB_PUBLISH_ADDRESS=127.0.0.1
DB_PUBLISH_PORT=3306

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# 50+ random characters. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
# Rotating it invalidates every session and every issued JWT.
SECRET_KEY=

# Space-separated. Name the hostnames the reverse proxy serves; do not use *.
ALLOWED_HOSTS=alcali.example.com

DJANGO_DEBUG=false
USE_TZ=true

# ---------------------------------------------------------------------------
# Behind a TLS-terminating reverse proxy
# ---------------------------------------------------------------------------
# Set all four once TLS is in front. SECURE_PROXY_SSL_HEADER is already wired
# to X-Forwarded-Proto, so the proxy must set that header and must strip any
# copy arriving from the client.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# Space-separated, scheme included. Django rejects unlisted cross-origin POSTs.
CSRF_TRUSTED_ORIGINS=https://alcali.example.com

# ---------------------------------------------------------------------------
# Salt API
# ---------------------------------------------------------------------------
# rest_cherrypy on the master. HTTPS: Alcali forwards user credentials here.
SALT_URL=https://salt-master.example.com:8080
# The eauth backend Alcali logs users in against. `rest` is the integrated
# path, where the master calls back to Alcali's /api/token/verify/ endpoint;
# see docs/docs/docker.md for the master-side external_auth block.
SALT_AUTH=rest
# The master's own minion id, used as the target for module/runner discovery.
MASTER_MINION_ID=master
SALT_TIMEOUT=30

# Certificate verification. Leave true. If the master uses an internal CA,
# mount the CA bundle into the alcali-tls volume and point this at it.
SALT_VERIFY_TLS=true
# SALT_CA_BUNDLE=/etc/alcali/tls/salt-ca.pem

# ---------------------------------------------------------------------------
# Optional authentication backends
# ---------------------------------------------------------------------------
# Requires an image built with the matching extra. Unset for local accounts.
# AUTH_BACKEND=ldap
